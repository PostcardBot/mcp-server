{
  "name": "@postcardbot/mcp-server",
  "version": "1.3.0",
  "description": "MCP server for sending physical postcards via Postcard.bot. Let AI agents send real postcards worldwide.",
  "main": "dist/index.js",
  "bin": {
    "postcardbot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "postcard",
    "postcardbot",
    "ai",
    "claude",
    "physical-mail",
    "modelcontextprotocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostcardBot/mcp-server.git"
  },
  "homepage": "https://postcard.bot/developers",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/PostcardBot/mcp-server/issues"
  }
